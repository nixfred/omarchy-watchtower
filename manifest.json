{
  "schemaVersion": 1,
  "id": "io.github.nixfred.watchtower",
  "name": "Watchtower",
  "version": "1.0.0",
  "author": "Fred Nix & Varry",
  "license": "MIT",
  "description": "A quiet perimeter alarm that explains exposed listeners with process, service, container, firewall, and network-scope context.",
  "kinds": ["bar-widget"],
  "entryPoints": {"barWidget": "Panel.qml"},
  "barWidget": {
    "displayName": "Watchtower",
    "description": "Lights up when a new process listens beyond localhost, then explains what it is doing and how reachable it is.",
    "category": "Security",
    "aliases": ["ports", "listeners", "firewall", "security", "network"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {"refreshIntervalSec": 15, "includeLocal": false},
    "schema": [
      {"key":"refreshIntervalSec","type":"integer","label":"Scan interval (seconds)","min":5,"max":300,"step":5,"defaultValue":15},
      {"key":"includeLocal","type":"boolean","label":"Show localhost listeners","defaultValue":false}
    ]
  },
  "homepage": "https://github.com/nixfred/omarchy-watchtower"
}
